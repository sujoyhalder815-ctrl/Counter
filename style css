 body {

    margin: 0;
    padding:0;

    font-family: Arial, sans-serif;

    background: #bde8ff;

    display: flex;

    justify-content: center;

    align-items: center;

    height: 100vh;

 }


 .container {

    text-align: center;

    background:hotpink;

    padding: 40px;

    border-radius: 15px;

          box-shadow: 0 5px 20px rgba(0, 0, 0, 0.2);

 }

 h1{
        margin-bottom: 20px;
      font-size: 28px;
    }
 

    #count {
      font-size: 70px;
      font-weight: bold;
      margin: 20px 0;
    }

 
button {
      padding: 12px 20px;

      font-size: 18px;

      border: none;

      border-radius: 8px;

      margin: 10px;

      cursor: pointer;

      color: white;
    }


    #Decrement{
        background-color: red;
        
        
    }

    #Reset{
        background-color: yellowgreen;
    }

     #increment {
        background-color: red;
    }

    button :hover {

        background-color: white
        
         opacity: 0.8;
    }
    


    

